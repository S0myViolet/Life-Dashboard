# Personal Home — environment settings (names only; never commit real values)
#
# Local development: copy to apps/web/.env.local and fill in.
# Production: set these in the Vercel project (web) and as Supabase Edge Function secrets (jobs).
# Anything in an optional group can stay blank: that connection shows "Needs setup" and the rest of
# the dashboard keeps working.

# ── Core (required) ─────────────────────────────────────────────────────────────
# Supabase project URL and publishable key (Project Settings → API Keys). Safe for browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...). Server only: Auth admin + private Storage.
SUPABASE_SECRET_KEY=
# Postgres connection string. On Vercel use the transaction pooler (port 6543).
DATABASE_URL=
# The only Google account allowed to own the dashboard.
OWNER_EMAIL=
# Public origin of the app, e.g. https://home.example.com (used for OAuth redirect URIs).
APP_URL=
# 32 random bytes, base64. Encrypts provider refresh tokens. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Background jobs (Supabase Edge Function secrets) ───────────────────────────
# Shared secret pg_cron sends to the dispatcher function. Generate: openssl rand -base64 32
DISPATCHER_SECRET=

# ── Gmail + Google Calendar (optional, per-account OAuth) ──────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Outlook mail + calendar (optional) ─────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Banking via Lunch Flow Personal API (optional) ─────────────────────────────
LUNCHFLOW_API_KEY=

# ── AI (optional; the dashboard works without it) ──────────────────────────────
GEMINI_API_KEY=

# ── Later milestones (optional) ────────────────────────────────────────────────
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
FOOTBALL_DATA_TOKEN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Tests only (never set on Vercel; ignored there) ───────────────────────────
# PH_E2E_AUTH=1
# PH_E2E_AUTH_SECRET=
